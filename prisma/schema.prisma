generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("PARENT") // PARENT | ADMIN
  phone        String?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  children     Child[]
}

model Child {
  id         String     @id @default(cuid())
  firstName  String
  lastName   String
  birthDate  DateTime?
  school     String
  grade      String
  stopName   String?    // bevorzugte Bushaltestelle
  notes      String?
  parent     User       @relation(fields: [parentId], references: [id], onDelete: Cascade)
  parentId   String
  absences   Absence[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Absence {
  id        String   @id @default(cuid())
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  childId   String
  fromDate  DateTime
  toDate    DateTime
  reason    String?
  createdAt DateTime @default(now())
}

model SchoolPlan {
  id          String   @id @default(cuid())
  school      String
  title       String
  validFrom   DateTime?
  validTo     DateTime?
  rawText     String   // Original Text/Inhalt
  aiSummary   String?  // KI-Zusammenfassung
  aiSchedule  String?  // KI-extrahierte Stundenpläne (JSON)
  createdAt   DateTime @default(now())
  createdBy   String?
}

model BusRoute {
  id          String     @id @default(cuid())
  name        String
  description String?
  active      Boolean    @default(true)
  stops       BusStop[]
  trips       BusTrip[]
  createdAt   DateTime   @default(now())
}

model BusStop {
  id        String   @id @default(cuid())
  route     BusRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routeId   String
  name      String
  orderIdx  Int
  arriveAt  String   // HH:MM
}

model BusTrip {
  id          String   @id @default(cuid())
  route       BusRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routeId     String
  direction   String   // HIN | RUECK
  dayOfWeek   Int      // 1=Mo ... 5=Fr
  departureAt String   // HH:MM von Startpunkt
  notes       String?
}
